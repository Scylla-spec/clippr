# Infinity Barbers — Barbershop Booking & Queue System
# ENVIRONMENT VARIABLES — copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Your project URL and anon (public) key — safe to expose to the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── App ───────────────────────────────────────────────────────────────────────
# Public base URL — used for PWA manifest, OG tags, etc.
VITE_APP_URL=http://localhost:5173
